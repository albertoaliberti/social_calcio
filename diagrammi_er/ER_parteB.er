{"_main":{"step":"erDesign","restructuringHappened":false,"draftSaved":true,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1},"erDesign":{"model":{"uid":127,"erCode":"/* Entities */\nentity UTENTE {\n    id_utente (id),\n    mail,\n    generalita {\n        nome,\n        cognome,\n        data_nascita,\n        sesso\n    },\n    password_hash\n}\nentity CALCIATORE {\n    dadti_corporei (optional) {\n        peso (optional),\n        altezza (optional)\n    },\n    ruolo\n}\nentity ALLENATORE {\n    tipo_allenatore_es_portieri_vice_ecc\n}\nentity OSPITE\nentity GENITORE\nentity SOCIETA {\n    id_societa (id),\n    nome_societa,\n    piva_societa\n}\nentity SQUADRA {\n    id_squadra (id),\n    nome_squadra,\n    TODO_entita_lega_con_relazione\n}\nentity TESSERAMENTO {\n    data_inizio_tesseramento (external),\n    data_fine_tesseramento\n}\nentity INCARICO {\n    data_fine_incarico (optional),\n    data_inizio_incarico (external)\n}\nentity DIRIGENTE\nentity STORICO_DIRIGENZA {\n    data_inizio (external),\n    data_fine (optional),\n    ruolo_presidente_amministratore\n}\nentity POST {\n    visibilita,\n    squadra_relazione_ottenibile_con_join,\n    id_post_relativo_utente (external),\n    timestamp\n}\nentity COMMENTO {\n    id_commento_relativo_post (external),\n    testo_commento,\n    timestamp\n}\nentity MEDIA {\n    id_media (id),\n    link_dati\n}\n\n/* Relationships */\nrelationship GENITORE_AUTORIZZA (\n    CALCIATORE: zero..one,\n    GENITORE: one..many\n) {\n    data_autorizzazione\n}\nrelationship SOCIETA_POSSIEDE (\n    SOCIETA: one..many,\n    SQUADRA: one..one\n)\nrelationship TESSERAMENTO_PRESSO (\n    SQUADRA: zero..many,\n    TESSERAMENTO: one..one\n)\nrelationship INCARICO_PRESSO (\n    SQUADRA: zero..many,\n    INCARICO: one..one\n)\nrelationship TESSERAMENTO_DI (\n    TESSERAMENTO: one..one external,\n    CALCIATORE: zero..many\n)\nrelationship INCARICO_DI (\n    INCARICO: one..one external,\n    ALLENATORE: zero..many\n)\nrelationship DIRIGENTE_HA_DIRETTO (\n    STORICO_DIRIGENZA: one..one external,\n    DIRIGENTE: zero..many\n)\nrelationship SOCIETA_STATA_DIRETTA (\n    SOCIETA: zero..many,\n    STORICO_DIRIGENZA: one..one external\n)\nrelationship POST_PUBBLICATO_DA (\n    UTENTE: zero..many,\n    POST: one..one external\n)\nrelationship AUTORE_COMMENTO (\n    UTENTE: zero..many,\n    COMMENTO: one..one external\n)\nrelationship COMMENTO_AL_POST (\n    POST: zero..many,\n    COMMENTO: one..one external\n)\nrelationship MEDIA_DEL_COMMENTO (\n    COMMENTO: zero..many,\n    MEDIA: zero..many\n)\nrelationship MEDIA_DEL_POST (\n    POST: zero..many,\n    MEDIA: zero..many\n)\nrelationship LIKE_A_POST (\n    POST: zero..many,\n    UTENTE: zero..many\n) {\n    timestamp_\n}\nrelationship SEGUE (\n    UTENTE \"e_seguito\": zero..many,\n    UTENTE \"segue\": zero..many\n)\nrelationship LIKE_A_COMMENTO (\n    UTENTE: zero..many,\n    COMMENTO: zero..many\n) {\n    timestamp\n}\n\n/* Generalizations */\nUTENTE <= {\n    CALCIATORE,\n    ALLENATORE,\n    OSPITE,\n    GENITORE,\n    DIRIGENTE\n} (partial, overlapping)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":1,"_name":"UTENTE","_x":-266,"_y":-90,"_mag":false},{"__type":"Attribute","_id":2,"_name":"id_utente","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-140,"_y":0},{"__type":"Attribute","_id":3,"_name":"mail","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-138,"_y":-42},{"__type":"Attribute","_id":4,"_name":"generalita","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-267,"_y":87},{"__type":"Attribute","_id":5,"_name":"password_hash","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-134,"_y":-73},{"__type":"Attribute","_id":8,"_name":"nome","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":4,"_x":-100,"_y":0},{"__type":"Attrib