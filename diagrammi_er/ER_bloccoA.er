{"_main":{"step":"erDesign","restructuringHappened":false,"draftSaved":true,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1},"erDesign":{"model":{"uid":68,"erCode":"/* Entities */\nentity UTENTE {\n    id_utente (id),\n    mail,\n    generalita {\n        nome,\n        cognome,\n        data_nascita,\n        sesso\n    },\n    password_hash\n}\nentity CALCIATORE {\n    dadti_corporei (optional) {\n        peso (optional),\n        altezza (optional)\n    },\n    ruolo\n}\nentity ALLENATORE {\n    tipo_allenatore_es_portieri_vice_ecc\n}\nentity OSPITE\nentity GENITORE\nentity SOCIETA {\n    id_societa (id)\n}\nentity SQUADRA {\n    id_squadra (id),\n    nome_squadra,\n    TODO_entita_lega_con_relazione\n}\nentity TESSERAMENTO {\n    data_inizio_tesseramento (external),\n    data_fine_tesseramento\n}\nentity INCARICO {\n    data_fine_incarico (optional),\n    data_inizio_incarico (external)\n}\n\n/* Relationships */\nrelationship GENITORE_AUTORIZZA (\n    CALCIATORE: zero..one,\n    GENITORE: one..many\n) {\n    data_autorizzazione\n}\nrelationship SOCIETA_POSSIEDE (\n    SOCIETA: one..many,\n    SQUADRA: one..one\n)\nrelationship TESSERAMENTO_PRESSO (\n    SQUADRA: zero..many,\n    TESSERAMENTO: one..one\n)\nrelationship INCARICO_PRESSO (\n    SQUADRA: zero..many,\n    INCARICO: one..one\n)\nrelationship TESSERAMENTO_DI (\n    TESSERAMENTO: one..one external,\n    CALCIATORE: zero..many\n)\nrelationship INCARICO_DI (\n    INCARICO: one..one external,\n    ALLENATORE: zero..many\n)\n\n/* Generalizations */\nUTENTE <= {\n    CALCIATORE,\n    ALLENATORE,\n    OSPITE,\n    GENITORE\n} (partial, overlapping)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":1,"_name":"UTENTE","_x":-116,"_y":42,"_mag":false},{"__type":"Attribute","_id":2,"_name":"id_utente","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-140,"_y":0},{"__type":"Attribute","_id":3,"_name":"mail","_identifier":false,"_externalI